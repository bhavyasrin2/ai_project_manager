# AI Project Manager — Backend Environment Variables
# Copy this to .env and fill in your actual values
# NEVER commit .env to git

# Your Gmail address — used for sending + receiving task emails
YOUR_EMAIL=your@gmail.com

# Claude / Anthropic API key for AI plan generation
ANTHROPIC_API_KEY=sk-ant-...

# SQLite database file path
# Local default: ./life_os.db
# Render production: /data/life_os.db  (set via render.yaml)
DB_PATH=./life_os.db

# Google OAuth token file path
# Local default: google_auth/token.json
# Render production: /etc/secrets/token.json  (uploaded as Render secret file)
GOOGLE_TOKEN_PATH=google_auth/token.json

# Comma-separated list of allowed CORS origins
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
